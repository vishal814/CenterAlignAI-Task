# CentrAlign AI Operator Configuration

# Google Gemini API Configuration (Optional: fallback engine is active if key not provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Enterprise Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./enterprise.db

# Enterprise SOP / Policy Rules
AUTO_REFUND_THRESHOLD=5000

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=true
